# Copy to mac-server/.env and fill in real values.
# .env is gitignored; NEVER commit real secrets.

# ─── Speech-to-text ─────────────────────────────────────────
# "mistral" (cloud, fast, accurate) or "whisper" (local via faster-whisper)
STT_BACKEND=mistral

# Required when STT_BACKEND=mistral. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=

# Optional overrides
MISTRAL_STT_MODEL=voxtral-mini-latest

# ─── LLM (Ollama) ───────────────────────────────────────────
# Main chat model used by the agent. Must be pulled via `ollama pull <name>`.
# qwen3.5 is multimodal (text + image) and supports tool calling, so a single
# model handles everything.
#   ollama pull qwen3.5:9b
# Other good tool-calling picks (text-only): qwen3:8b, qwen2.5:7b, llama3.1:8b
OLLAMA_MODEL=qwen3.5:9b

# Optional: separate vision model for the describe_image tool. Leave blank
# when your main model is already multimodal (e.g. qwen3.5); the server will
# reuse OLLAMA_MODEL automatically. Only set this if your main model is
# text-only and you want e.g. llama3.2-vision:11b for images.
OLLAMA_VISION_MODEL=

# ─── Agent sandbox ──────────────────────────────────────────
# Folder the agent can read/write. Created on first run if missing.
# Stays on your Mac; nothing outside this folder is accessible to the agent.
AGENT_ROOT=~/Desktop/pony_agent
